# GEMINI_API_KEY: Gemini API key used by the weather chatbot.
# Intentionally not prefixed with VITE_ — Vite only exposes VITE_-prefixed
# vars to client code, so this stays server-side only (e.g. a Vercel
# serverless function under /api) and never ends up in the browser bundle.
GEMINI_API_KEY="your_gemini_api_key_here"
