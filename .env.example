# GEMINI_API_KEY: Gemini API key used by the weather chatbot.
# Intentionally not prefixed with VITE_ — Vite only exposes VITE_-prefixed
# vars to client code, so this stays server-side only (e.g. a Vercel
# serverless function under /api) and never ends up in the browser bundle.
GEMINI_API_KEY="your_gemini_api_key_here"

# VITE_KAKAO_MAP_KEY: Kakao Maps JavaScript SDK app key.
# Prefixed with VITE_ on purpose — the Kakao Maps JS SDK runs in the
# browser, so this key must be exposed to client code. It is restricted
# to your registered domains in the Kakao Developers console, not a
# server secret like GEMINI_API_KEY above.
VITE_KAKAO_MAP_KEY="your_kakao_javascript_key_here"
